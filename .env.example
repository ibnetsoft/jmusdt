# demo: UI preview only. live: requires Supabase Auth and PostgreSQL.
APP_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Dedicated DB role, not a browser secret. TLS verification stays enabled.
DATABASE_SSL=true
DATABASE_SSL_CA_FILE=
APP_ORIGIN=http://127.0.0.1:3000
# nile | mainnet. Mainnet contract is fixed to official Tether USDT.
TRON_NETWORK=nile
TRON_USDT_CONTRACT=
TRONGRID_API_KEY=
# Set before first scan; historical replay uses the durable cursor thereafter.
TRON_START_BLOCK=
TRON_HOT_WALLET_ADDRESS=
# External custody service: /addresses and /sign. No private keys in web app/DB.
CUSTODY_URL=
CUSTODY_TOKEN=
# Explicit opt-in, also required for Nile broadcasts.
TRON_BROADCAST_ENABLED=false
WITHDRAWAL_FEE_USDT=1
MIN_WITHDRAWAL_USDT=10
TRON_FEE_LIMIT_SUN=100000000
