# demo: UI preview only. live: requires Supabase Auth and PostgreSQL.
APP_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional, server-only. Used only by the explicitly invoked QA verification script.
SERVICE_ROLE_KEY=
DATABASE_URL=
# Dedicated DB role, not a browser secret. TLS verification stays enabled.
DATABASE_SSL=true
DATABASE_SSL_CA_FILE=
APP_ORIGIN=http://127.0.0.1:3000
# Additional trusted browser origins, comma-separated; exact matches only.
APP_ALLOWED_ORIGINS=
# nile | mainnet. Mainnet contract is fixed to official Tether USDT.
TRON_NETWORK=nile
TRON_USDT_CONTRACT=
TRONGRID_API_KEY=
# Optional dedicated encryption key (32+ characters); CRON_SECRET is used if omitted.
# The same value is required on web and all TRON workers. Do not rotate without re-encrypting.
TRONGRID_SETTINGS_ENCRYPTION_KEY=
# Company wallet encryption and scheduler secrets; back up securely and never rotate without migration.
COMPANY_WALLET_ENCRYPTION_KEY=
COMPANY_TRANSFER_CRON_SECRET=
# Mainnet member-address custody uses a protected Vault mnemonic when enabled.
INTERNAL_CUSTODY_ENABLED=false
SWEEP_BROADCAST_ENABLED=false
# Optional: enable member collection after an authorized company wallet is created.
SWEEP_ENABLE_ON_WALLET_CREATE=false
# Set before first scan; historical replay uses the durable cursor thereafter.
TRON_START_BLOCK=
TRON_HOT_WALLET_ADDRESS=
# External custody service: /addresses and /sign. No private keys in web app/DB.
CUSTODY_URL=
CUSTODY_TOKEN=
# Explicit opt-in, also required for Nile broadcasts.
TRON_BROADCAST_ENABLED=false
WITHDRAWAL_FEE_USDT=1
MIN_WITHDRAWAL_USDT=10
TRON_FEE_LIMIT_SUN=100000000
# Server-only Vercel daily job authentication. Never prefix NEXT_PUBLIC_.
CRON_SECRET=
# Optional dedicated key; CRON_SECRET is the fallback. Same key on web instances.
SWEEP_REVIEW_SECRET=
